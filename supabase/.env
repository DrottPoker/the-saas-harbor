# Committed defaults for supabase/config.toml. No secrets belong here.
# Override per machine in supabase/.env.local (git-ignored), which the Supabase CLI loads after this file.

# Auth email: off means every email goes to the local Mailpit inbox.
HARBOR_SMTP_ENABLED=false
HARBOR_SMTP_HOST=smtp.example.com
HARBOR_SMTP_PORT=587
HARBOR_SMTP_USER=
HARBOR_SMTP_PASS=
HARBOR_SMTP_ADMIN_EMAIL=noreply@example.com
HARBOR_SMTP_SENDER_NAME=The SaaS Harbor

# Production Auth email (see [remotes.production] in config.toml). `npm run auth:production` sets
# the real values for Resend in the environment of `supabase config push`; never put them in a file.
HARBOR_PRODUCTION_SMTP_ENABLED=false
HARBOR_PRODUCTION_SMTP_HOST=smtp.example.com
HARBOR_PRODUCTION_SMTP_PORT=587
HARBOR_PRODUCTION_SMTP_USER=
HARBOR_PRODUCTION_SMTP_PASS=
HARBOR_PRODUCTION_SMTP_ADMIN_EMAIL=noreply@thesaasharbor.com
HARBOR_PRODUCTION_SMTP_SENDER_NAME=The SaaS Harbor
