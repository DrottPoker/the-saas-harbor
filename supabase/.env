# Committed defaults for supabase/config.toml. No secrets belong here.
# Override per machine in supabase/.env.local (git-ignored), which the Supabase CLI loads after this file.

# Auth email: off means every email goes to the local Mailpit inbox.
HARBOR_SMTP_ENABLED=false
HARBOR_SMTP_HOST=smtp.example.com
HARBOR_SMTP_PORT=587
HARBOR_SMTP_USER=
HARBOR_SMTP_PASS=
HARBOR_SMTP_ADMIN_EMAIL=noreply@example.com
HARBOR_SMTP_SENDER_NAME=The SaaS Harbor

# Production Auth email (see [remotes.production] in config.toml). `npm run auth:production` sets
# the real values for Resend in the environment of `supabase config push`; never put them in a file.
HARBOR_PRODUCTION_SMTP_ENABLED=false
HARBOR_PRODUCTION_SMTP_HOST=smtp.example.com
HARBOR_PRODUCTION_SMTP_PORT=587
HARBOR_PRODUCTION_SMTP_USER=
HARBOR_PRODUCTION_SMTP_PASS=
HARBOR_PRODUCTION_SMTP_ADMIN_EMAIL=noreply@thesaasharbor.com
HARBOR_PRODUCTION_SMTP_SENDER_NAME=The SaaS Harbor

# Sign-in with Google, off by default. To try it locally, set all three in supabase/.env.local with
# an OAuth client of your own (see README).
HARBOR_GOOGLE_ENABLED=false
HARBOR_GOOGLE_CLIENT_ID=
HARBOR_GOOGLE_SECRET=

# Production sign-in with Google. The client ID is public; `npm run auth:production` asks for the
# secret and turns Google on when a client ID is set here.
HARBOR_PRODUCTION_GOOGLE_ENABLED=false
HARBOR_PRODUCTION_GOOGLE_CLIENT_ID=40002606114-jb2dqdveitmarup80gv92qi76r4u0c88.apps.googleusercontent.com
HARBOR_PRODUCTION_GOOGLE_SECRET=

# Sign-in with GitHub, off by default. To try it locally, set all three in supabase/.env.local with
# a GitHub OAuth App of your own (see README).
HARBOR_GITHUB_ENABLED=false
HARBOR_GITHUB_CLIENT_ID=
HARBOR_GITHUB_SECRET=

# Production sign-in with GitHub. The client ID is public; `npm run auth:production` asks for the
# secret and turns GitHub on when a client ID is set here.
HARBOR_PRODUCTION_GITHUB_ENABLED=false
HARBOR_PRODUCTION_GITHUB_CLIENT_ID=
HARBOR_PRODUCTION_GITHUB_SECRET=
