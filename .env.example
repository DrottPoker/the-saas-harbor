# `npm run dev` writes these to .env.local from the local Supabase stack (scripts/local-env.mjs).
# Only public values belong here. Never add secret or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Local development only: where auth emails are caught instead of being sent.
LOCAL_MAILPIT_URL=http://127.0.0.1:55324
