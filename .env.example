# `npm run dev` writes these to .env.local from the local Supabase stack (scripts/local-env.mjs).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Local development only: where auth emails are caught instead of being sent.
LOCAL_MAILPIT_URL=http://127.0.0.1:55324

# Server-only secrets for revenue verification. Never prefix them with NEXT_PUBLIC_.
# Service-role key of the Supabase instance, used only for trusted verification writes.
SUPABASE_SECRET_KEY=
# 32 random bytes, base64. Encrypts stored payment provider keys; changing it makes them
# unreadable.
STRIPE_KEY_ENCRYPTION_KEY=
# At least 32 characters. Bearer secret for POST /api/revenue/sync and POST /api/email/send. In
# production the same value is in Supabase Vault as harbor_cron_secret, for the scheduled jobs.
CRON_SECRET=
# Accept test keys and sandboxes: rk_test_ and pdl_sdbx_ keys, and Polar and Dodo Payments test
# accounts (local development only; leave unset in production).
REVENUE_ALLOW_TEST_KEYS=true
# Notification emails through any SMTP provider. Without SMTP_HOST and EMAIL_FROM nothing is sent
# and emails wait in the queue. `npm run dev` points them at the local Mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=55325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=The SaaS Harbor <notifications@harbor.localhost>
# How long a message email waits for the recipient to read the message first (default 300).
# MESSAGE_EMAIL_DELAY_SECONDS=300

# `off` hides the made-up demo products at once. By default they fill the lists until 12 real
# products share verified MRR.
# DEMO_PRODUCTS=off

# Optional overrides, used by the tests' fake provider server. Paddle, Polar and Dodo Payments
# add /live or /test to theirs.
# STRIPE_API_BASE=https://api.stripe.com
# PADDLE_API_BASE=
# POLAR_API_BASE=
# DODO_API_BASE=
# FX_API_BASE=https://api.frankfurter.dev
