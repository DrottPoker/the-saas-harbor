# `npm run dev` writes these to .env.local from the local Supabase stack (scripts/local-env.mjs).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Local development only: where auth emails are caught instead of being sent.
LOCAL_MAILPIT_URL=http://127.0.0.1:55324

# Server-only secrets for Stripe verification. Never prefix them with NEXT_PUBLIC_.
# Service-role key of the Supabase instance, used only for trusted verification writes.
SUPABASE_SECRET_KEY=
# 32 random bytes, base64. Encrypts stored Stripe keys; changing it makes them unreadable.
STRIPE_KEY_ENCRYPTION_KEY=
# At least 32 characters. Bearer secret for POST /api/stripe/sync.
CRON_SECRET=
# Accept rk_test_ keys (local development only; leave unset in production).
STRIPE_ALLOW_TEST_KEYS=true
# Optional overrides, used by the browser tests' fake Stripe server.
# STRIPE_API_BASE=https://api.stripe.com
# FX_API_BASE=https://api.frankfurter.dev
